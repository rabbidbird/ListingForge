# Runtime: production requires PostgreSQL, HTTPS, secure cookies, and a unique secret.
# SESSION_SECRET must be unique in production. Documented example/dev values are rejected.
ENV=development
PORT=8080
DATABASE_URL=sqlite:///data/truedraft_dev.db
# Production example: postgresql://USER:PASSWORD@HOST:5432/truedraft
PUBLIC_BASE_URL=http://localhost:8080
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=truedraft_session
SESSION_COOKIE_SECURE=false
SESSION_DAYS=30

# Optional email-verification stub. Keep false until an email adapter is implemented.
EMAIL_VERIFICATION_REQUIRED=false

# Optional Google account creation and sign-in. When either credential is missing,
# SellerDrafts hides the Google button and password authentication keeps working.
# The redirect URI defaults to PUBLIC_BASE_URL + /auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Stripe subscriptions. Prefer a least-privilege restricted key (rk_...).
# Billing buttons stay disabled until the key, webhook secret, and all three Price IDs are set.
# Checkout success/cancel and portal return URLs are derived from PUBLIC_BASE_URL.
# Do not set STRIPE_SUCCESS_URL, STRIPE_CANCEL_URL, LISTINGFORGE_*, or *_SKIP_AUTH.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Optional OpenAI-compatible LLM phrase ordering. It is off unless explicitly enabled.
# The provider returns allowlisted source-phrase IDs; free-form model prose is never exported.
LLM_ENABLED=false
LLM_KILL_SWITCH=false
LLM_TIMEOUT_SECONDS=25
LLM_MAX_TOKENS=1200
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Compatible alternatives, used only when configured by the operator:
XAI_API_KEY=
GROK_API_KEY=

# App-level CSV validation; nginx/Streamlit have slightly higher transport ceilings.
MAX_UPLOAD_BYTES=2000000
