# Optional real LLM generation
OPENAI_API_KEY=sk-...
# Or for xAI / Grok:
# XAI_API_KEY=xai-...
# OPENAI_BASE_URL=https://api.x.ai/v1

# Optional local auth bypass for dev
LISTINGFORGE_SKIP_AUTH=true
LISTINGFORGE_USER_ID=demo-user  # optional in no-auth mode; omit for per-session IDs

# Optional per-plan caps
LISTINGFORGE_DEFAULT_PLAN=free
LISTINGFORGE_FREE_DAILY_LIMIT=8
LISTINGFORGE_FREE_MONTHLY_LIMIT=40
LISTINGFORGE_STARTER_DAILY_LIMIT=50
LISTINGFORGE_STARTER_MONTHLY_LIMIT=500

# Optional auth mode (true = enforce Streamlit login)
# If false (default), auth is optional and LISTINGFORGE_USER_ID is used
LISTINGFORGE_REQUIRE_AUTH=false

# Optional password gate (if using auth_simple.py in custom flows)
LISTINGFORGE_PASSWORD=listingforge

# Stripe (optional, for paid plans)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...
STRIPE_SUCCESS_URL=https://your-domain.com/
STRIPE_CANCEL_URL=https://your-domain.com/
