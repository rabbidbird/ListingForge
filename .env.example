# Optional: enable real LLM generation (OpenAI-compatible)
# Leave blank to use the high-quality template engine (no cost, offline capable)

OPENAI_API_KEY=sk-...
# Or for xAI / Grok:
# XAI_API_KEY=xai-...
# OPENAI_BASE_URL=https://api.x.ai/v1

# Optional model override
# LISTINGFORGE_MODEL=gpt-4o-mini
# LISTINGFORGE_MODEL=grok-3

# For Streamlit secrets (preferred in production):
# Create .streamlit/secrets.toml with:
# OPENAI_API_KEY = "sk-..."
# or
# XAI_API_KEY = "xai-..."
