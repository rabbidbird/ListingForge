pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    access_log /dev/stdout;
    client_body_temp_path /tmp/nginx-client-body;
    proxy_temp_path /tmp/nginx-proxy;
    fastcgi_temp_path /tmp/nginx-fastcgi;
    uwsgi_temp_path /tmp/nginx-uwsgi;
    scgi_temp_path /tmp/nginx-scgi;
    server_tokens off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # The supported Railway topology exposes this origin only through its HTTP
    # edge, which overwrites X-Real-IP and adds X-Railway-Edge. Gate use of those
    # headers on Railway's server-side environment ID and valid formats.
    # Direct/local deployments therefore ignore client-supplied forwarding
    # headers and use nginx's peer address. The global zone remains a backstop.
    map "${RAILWAY_ENVIRONMENT_ID}:$http_x_railway_edge:$http_x_real_ip" $truedraft_client_ip {
        "~^[0-9A-Fa-f-]{32,36}:[a-z]{3}[0-9]+:([0-9]{1,3}\.){3}[0-9]{1,3}$" $http_x_real_ip;
        "~^[0-9A-Fa-f-]{32,36}:[a-z]{3}[0-9]+:[0-9A-Fa-f:]{2,45}$" $http_x_real_ip;
        default $remote_addr;
    }

    map "${RAILWAY_ENVIRONMENT_ID}:$http_x_railway_edge:$http_x_forwarded_proto" $truedraft_client_proto {
        "~^[0-9A-Fa-f-]{32,36}:[a-z]{3}[0-9]+:https$" https;
        default $scheme;
    }

    # A per-client soft limit plus a deliberately generous container-wide
    # ceiling protects every anonymous surface, including Streamlit and
    # webhook/auth routes. Authentication also has a tighter bounded limiter in
    # core/web.py.
    limit_req_zone $truedraft_client_ip zone=truedraft_client_requests:10m rate=20r/s;
    limit_conn_zone $truedraft_client_ip zone=truedraft_client_connections:10m;
    limit_req_zone $server_name zone=truedraft_global_requests:1m rate=100r/s;
    limit_conn_zone $server_name zone=truedraft_global_connections:1m;
    limit_req_status 429;
    limit_conn_status 429;

    server {
        listen ${PORT};
        server_name _;
        client_max_body_size 3m;
        # Streamlit's chunked frontend can request well over 60 static assets on
        # first load. Keep the sustained rate at 20r/s while allowing startup.
        limit_req zone=truedraft_client_requests burst=300 nodelay;
        limit_req zone=truedraft_global_requests burst=200 nodelay;
        limit_conn truedraft_client_connections 100;
        limit_conn truedraft_global_connections 200;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        location = /healthz {
            proxy_pass http://127.0.0.1:8000;
            # Railway and Docker may probe with internal Host values. The health
            # backend is loopback-only, so normalize it to an explicitly trusted host.
            proxy_set_header Host 127.0.0.1;
            proxy_set_header X-Real-IP $truedraft_client_ip;
            proxy_set_header X-Forwarded-Proto $truedraft_client_proto;
        }

        location = /webhooks/stripe {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $truedraft_client_ip;
            proxy_set_header X-Forwarded-Proto $truedraft_client_proto;
        }

        location ^~ /auth/ {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $truedraft_client_ip;
            proxy_set_header X-Forwarded-Proto $truedraft_client_proto;
        }

        location / {
            proxy_pass http://127.0.0.1:8501;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $truedraft_client_ip;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $truedraft_client_proto;
            proxy_read_timeout 86400;
            proxy_buffering off;
        }
    }
}
